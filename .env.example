# ============================================
# Bootcamp GitLab CE — Variables de entorno
# Copiar a .env y ajustar segun necesidad
#
# PRIVACIDAD: toda la telemetria esta deshabilitada por defecto
# en docker-compose.yml (usage_ping, sentry, snowplow, google_analytics)
# ============================================

# ── GitLab CE (perfil: base) ──
# La version esta pinneada a proposito: el material se comprobo contra ella.
# Ver docs/stack-versions.md antes de subirla.
GITLAB_VERSION=19.2.4-ce.0
GITLAB_HOST=gitlab
GITLAB_EXTERNAL_URL=http://localhost:8888
GITLAB_HTTP_PORT=8888
GITLAB_SSH_PORT=2224
GITLAB_ROOT_PASSWORD=ChangeMe123!

# ── Container Registry integrado (S13) ──
REGISTRY_PORT=5050

# ── GitLab Pages (S14) ──
PAGES_HOST=pages.localhost
PAGES_PORT=8090

# ── GitLab Runner (perfil: base) ──
# Misma serie que GitLab: un runner mas nuevo que el servidor no esta soportado.
RUNNER_VERSION=alpine-v19.2.2

# ── Cache de registry (perfil: base) ──
# Opcional: con credenciales de Docker Hub evitas el rate limit de pulls anonimos.
DOCKER_HUB_USER=
DOCKER_HUB_TOKEN=
REGISTRY_CACHE_PORT=5000

# ── Observabilidad (perfil: observabilidad, S21) ──
PROMETHEUS_VERSION=2.54.1
PROMETHEUS_PORT=9090
GRAFANA_VERSION=11.2.0
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
LOKI_VERSION=3.2.0
LOKI_PORT=3100
